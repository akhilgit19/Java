package com.flm.throwsandthrow;

import java.util.Scanner;

public class ThrowDemo {
	

	public static void main(String[] args) {
		
		
		System.out.println("Welcome to utu bank");
		
		Scanner sc = new Scanner(System.in);
		
		try {
			int minBal = sc.nextInt();
			if(minBal < 1000) {
//				throw new IllegalArgumentException("Min Bal should be greater than 100");//predefined exceptions
//			
				throw new MiniumBalanceException("Min Bal should be greater than 100"); //custom exceptions
				
			}
	
	
		}catch(Exception e){
			System.out.println("Something is wrong");
			System.out.println(e.getMessage());
	
		}
	}

}



