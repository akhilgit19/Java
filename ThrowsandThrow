public class ThrowsDemo {
	
	
	/**
	 * 
	 * 
	 * 
	 * Throws 
	 * -  Bypassing exception from present method to caller method
	 * -  if no caller handles, JVM will take care of the exception
	 * 
	 * User also can raise exceptoin manully in program
	 * that is throw e
	 * 
	 */
	
	public static void main(String[] args) throws FileNotFoundException {
		
		
		ThrowsDemo td = new ThrowsDemo();
		td.ramesh();
		
	}
	
