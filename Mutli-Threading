package com.flm.multithreading;

public class MyThirdThread  implements Runnable {
	
	
	
	@Override
	public void run() {
	
		
		 Thread Threadinformation = Thread.currentThread();
		 int priority = Threadinformation.getPriority();
		 Threadinformation.setPriority(10);
		 
		 
		 String threadName = Threadinformation.getName();
		 

		for(int i=1; i<=10; i++) {
			
			System.out.println("bye"+i +threadName + priority);
		}
		
	}
	
	
	

}


package com.flm.multithreading;

public class MyThread extends Thread{
	
	
	@Override 
	public void run(){
		
		
		Thread MyThreadinformation = Thread.currentThread();
		int priority = MyThreadinformation.getPriority();
		
		MyThreadinformation.setPriority(5);
		
		
		 String threadName = MyThreadinformation.getName();
		 
		for(int i =1; i<=10; i++) {
			
			
			System.out.println("hi"+i+ threadName +  priority);
		}
	}
	
	
	/**
	 * 
	 * 
	 * 	public class Thread implements Runnable 
	
	
	Causes this thread to begin execution; the Java Virtual Machine
    * calls the {@code run} method of this thread.
    * <p>
    * The result is that two threads are running concurrently: the
    * current thread (which returns from the call to the
    * {@code start} method) and the other thread (which executes its
    * {@code run} method).
    * <p>
    * It is never legal to start a thread more than once.
    * In particular, a thread may not be restarted once it has completed
