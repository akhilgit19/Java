package com.flm.multithreading;

public class ThreadJoin {
	
	
	public static void main(String[] args) throws InterruptedException {
		
		
		/**
		 * 
		 * Instance variable can be 
		 * initialized by 4 way
		 *  at the time of decclearation
		 *  object reference
		 *  with help of constructors
		 *  getand setters
		 *  
		 */
		
		JD3 jd3Object = new JD3();
		
		JD2 jd2 = new JD2();
	    jd2.jd3= jd3Object;// object reference initialiazation
	    
	    jd3Object.start();
	  
		jd2.start();
		
		jd2.join();
		
		
		

		
		System.out.println("S3-Parsing data from files to save to DB");
		
	
		
	}

}


