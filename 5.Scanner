public class ScannerClass {
	
 
	 public static void main(String[] args) {
		
			
		 Scanner sc = new Scanner(System.in);
		 
         System.out.println("Please enter first name");
	     
         String firstName = sc.next();// Akhil\n-- next will not consider 1 token and spaces will not consider it will move \n  in the buffer
         
         sc.nextLine();
         String SecondName= sc.nextLine();
         
         System.out.println(firstName+SecondName);
//		   primitiveDataTypes();
//		   stringCharMethod();
//	       scanner();
		 
			
			
	}

	private static void primitiveDataTypes() {
		Scanner scannerObject = new Scanner(System.in);
		 
			System.out.println("Please enter byte value");
			byte b=scannerObject.nextByte();
	        
			System.out.println("Please enter short value");
	        short nextShort= scannerObject.nextShort();
	        
	        System.out.println("Please enter int value");
	        int intvalue=scannerObject.nextInt();
	        
	        System.out.println("Please enter long value");
	        long l=scannerObject.nextLong();
	        
	        System.out.println("Please enter double value");
	        double d=scannerObject.nextDouble();
	        
	        
	        System.out.println("Please enter float value");
	        float f=scannerObject.nextFloat();

	        System.out.println("Please enter boolean value");
	        boolean bool=scannerObject.nextBoolean();
	        
	        System.out.println("Please enter string value");
	        String str=scannerObject.nextLine();
	        
	        System.out.println("Please enter char value");
	        char c=scannerObject.nextLine().charAt(0);
	        
	        
	        System.out.println("Bytevalue- byte max value b=127" + b);
	        System.out.println("Shortvalue- short  max vlaue  s=12999" + nextShort);
	        System.out.println("Int value- integer max value i=1299999999" + intvalue);
	        System.out.println("Long value- long max value  l=899999999" + l);
	        System.out.println("Float value- float mav value  f=12.3888888888888888888888888f" + f);
	        System.out.println("Double value- double max value d =123.458687677777777777777777777" + d);
	        System.out.println("Boolean value- boolean value k =true" + bool);
	        System.out.println("Str value - boolean value k2=false" + str);
	        System.out.println("Char value- char value c " + c);
	}

	private static void scanner() {
		
		
		Scanner sc = new Scanner(System.in);
		System.out.println("Welcome to MIT Solution");
		System.out.println("Please enter a value");
		int a = sc.nextInt();
		System.out.println("Please enter b value");
		int b = sc.nextInt();
		int result = a + b;
		System.out.println("Result "+ result);
		
		
	}
	
	
	private static void stringCharMethod() {
		
		Scanner scannerObject = new Scanner(System.in)  ;
		System.out.println("Please enter a string value");
		String str = scannerObject.nextLine();
		System.out.println("You have enterered : "+ str);
		char char0 = str.charAt(0);
		char char1 = str.charAt(1);
		char char2 = str.charAt(2);
	
		System.out.println("char0 "+char0);
		System.out.println("char1 "+char1);
		System.out.println("char2 "+char2);
	}
	


}
